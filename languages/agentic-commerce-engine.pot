msgstr ""

#: admin/views/page-settings.php:47
msgid "Store the page path for each visit (per-page breakdowns)"
msgstr ""

#: admin/views/page-settings.php:49
msgid "Turn this off to keep only one aggregate row per crawler per day."
msgstr ""

#: admin/views/page-settings.php:52
